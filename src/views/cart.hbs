<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>
  </head>
  <body>
    <h1>Your Cart</h1>
    {{#if cart}}
      <ul>
        {{#each cart.products}}
          <li>
            <strong>{{this.product.title}}</strong> - ${{this.product.price}} (Quantity: {{this.quantity}})
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p>No products in this cart.</p>
    {{/if}}

    
  </body>
</html>
